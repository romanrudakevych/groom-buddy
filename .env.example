# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public app URL used in invite / password-reset email links (optional; defaults to current origin)
VITE_PUBLIC_URL=https://crm.example.com
# Postgres connection string (local only, never VITE_-prefixed). The CLI asks for the DB password,
# or reads it from the SUPABASE_DB_PASSWORD env var.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
